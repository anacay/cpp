---
// "Help build this page": a door to The Commons, Suggest an edit and the
// threads so far, at the foot of every body-of-knowledge page. The Commons
// link comes from streamPost() in site/src/data/room.mjs, prefilled with the
// page's name, link and topic tag.
import { links } from '../lib/community.mjs';
import { load } from '../lib/paper.mjs';
import { streamPost, tagForPath } from '../data/room.mjs';
interface Props { page?: any; file?: string; name?: string; what?: string; talk?: string; postTitle?: string }
const { page, file, name, what = 'This is part of the seed edition of an open body of knowledge.', talk = 'Talk about this page', postTitle } = Astro.props;
const l = links(page, { file, name });
const contact = load().config.site.contact;
const path = Astro.url.pathname;
const post = streamPost({ title: postTitle ?? `${l.name.replace(/^Guide:\s*/, '')} — `, tag: tagForPath(path), from: { name: postTitle ? postTitle.replace(/ — $/, '') : l.name.replace(/^Guide:\s*/, ''), url: path } });
---
<aside class="help-build" aria-labelledby="help-h">
  <h2 id="help-h">Help build this page</h2>
  <p>{what} If something here is wrong, unclear or missing, say so.</p>
  <ul class="help-build__actions">
    <li><a class="act" href={post}><span class="an">{talk}</span><span class="sr-only">:&nbsp;</span><span class="ad">Ask, push back or add what you know. Opens a post in The Commons.</span></a></li>
    {l.edit && <li><a class="act" href={l.edit}><span class="an">Suggest an edit</span><span class="sr-only">:&nbsp;</span><span class="ad">Change the text yourself. GitHub turns it into a pull request.</span></a></li>}
    <li><a class="act" href={l.threads}><span class="an">See the discussion</span><span class="sr-only">:&nbsp;</span><span class="ad">What others have said about {l.name}.</span></a></li>
  </ul>
  <p class="help-build__fine">
    {!l.open && <span><strong>Opening soon:</strong> the repository isn't open yet, so these links don't work. Until then, write to <a href={`mailto:${contact}?subject=${encodeURIComponent(l.name)}`}>{contact}</a>. </span>}
    {l.file && <span>Source file: <code>{l.file}</code>. </span>}
    <a href="/how-it-grows/">How a change is decided</a> · <a href="/commons/">The Commons</a>
  </p>
</aside>
