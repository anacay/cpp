---
// A short welcome for readers who arrive from an AI assistant's answer (R11):
// where the answer came from, and the one next step into The Commons.
interface Props { post: string; topic?: string }
const { post, topic } = Astro.props;
---
<aside class="from-answer reading" aria-label="Arrived from an AI answer?">
  <p><strong>Came here from an AI answer?</strong> This page is the source. Planners discuss {topic ? <>{topic}</> : 'it'} in The Commons. <a href={post}>Ask a follow-up</a> or <a href="/join/">see how to join</a>. It’s free, open and non-commercial.</p>
</aside>
