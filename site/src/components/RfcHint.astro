---
// The request-for-comments call to action at the top of every reading page.
// It shows the button people will get, so they know what to look for.
import { notesFor } from '../lib/notes.mjs';
interface Props { page?: any }
const { page } = Astro.props;
const n = page ? notesFor(page).length : 0;
---
<aside class="rfc" data-apparatus aria-label="How to comment on this page">
  <p class="rfc__kicker"><span class="rfc__dot" aria-hidden="true"></span>Request for comments</p>
  <p class="rfc__lead"><strong>Comment on any sentence.</strong> Select text anywhere on this page, like this, and a button appears at the bottom of your screen:</p>
  <div class="rfc__anim" aria-hidden="true">
    <p class="rfc__sample">Plans still miss, <span class="rfc__sel">more often because of the agreements around the formula</span> than the formula itself.</p>
    <p class="rfc__demo"><span class="rfc__q">“more often because of the agreements…”</span><span class="rfc__btn">Discuss this passage</span></p>
  </div>
  <p class="rfc__phone">On a phone, press and hold a word, then drag to select.</p>
  {n > 0 && <p class="rfc__notes">This page has {n} author’s {n === 1 ? 'note' : 'notes'} to start from, <span class="rfc__mk">marked in gold</span>.</p>}
  <p class="rfc__links"><a href="/join/#new">New here? How commenting works</a> · <a href="/open-questions/">Open questions</a> · <a href="/how-it-grows/">How comments become changes</a></p>
</aside>
