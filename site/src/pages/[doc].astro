---
import DocPage from '../components/DocPage.astro';
import { DOCS } from '../lib/community.mjs';
export function getStaticPaths() {
  const eyebrow = { 'CONTRIBUTING.md': 'Join in', 'CODE_OF_CONDUCT.md': 'Join in', 'HOW_IT_GROWS.md': 'Join in',
    'SHARING_SAFELY.md': 'The Practice Room', 'CONTRIBUTORS.md': 'Join in' };
  const navOf = { 'SHARING_SAFELY.md': 'room' };
  return Object.entries(DOCS).map(([file, url]) => ({
    params: { doc: url.replaceAll('/', '') },
    props: { file, eyebrow: eyebrow[file] ?? 'The practice', nav: navOf[file] ?? (eyebrow[file] ? 'join' : 'practice') },
  }));
}
const { file, eyebrow, nav } = Astro.props;
---
<DocPage file={file} eyebrow={eyebrow} nav={nav} />
