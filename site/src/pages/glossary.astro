---
// The glossary in three parts:
//  1. The seed paper's term lists (Terms used in this paper; Appendix A;
//     Appendix B), merged and alphabetical. Definitions are the paper's words,
//     unchanged; a term defined in two lists shows both. Where the guide has a
//     page that teaches a term, a "Read the concept" link follows.
//  2. Practice terms: words the guide uses that the seed's lists don't define.
//  3. Case 3 terms: Kuantillion Cloud's working vocabulary, so deep links resolve.
// Parts 2 and 3 live in src/data/practice-glossary.mjs. Ids share one
// term-<slug> namespace; a clash fails the build.
import Base from '../layouts/Base.astro';
import { load, glossary, renderInline, pageLabel, slugify } from '../lib/paper.mjs';
import { guide } from '../lib/guide.mjs';
import { PRACTICE_TERMS, CASE3_TERMS, SEED_CONCEPTS, SEED_NOTES } from '../data/practice-glossary.mjs';
const ctx = load();
const terms = glossary(ctx);
const g = guide();
const letterOf = (t) => t.term.replace(/^(the|a|an)\s+/i, '').charAt(0).toUpperCase();
const letters = [...new Set(terms.map(letterOf))];
const sources = [...new Set(terms.flatMap((t) => t.defs.map((d) => d.label)))].sort((a, b) => (a.startsWith('Terms') ? -1 : b.startsWith('Terms') ? 1 : a.localeCompare(b)));

// A guide file name (with optional #hash) to its URL; unknown files fail the build.
const guideUrl = (ref) => {
  const [file, hash] = ref.split('#');
  const p = g.byFile.get(file);
  if (!p) throw new Error(`glossary: link to missing guide page ${file}`);
  return p.url + (hash ? `#${hash}` : '');
};
const seedIds = new Set(terms.map((t) => t.id));
for (const id of Object.keys(SEED_CONCEPTS)) if (!seedIds.has(id)) throw new Error(`glossary: SEED_CONCEPTS names unknown term ${id}`);
const own = (list) => list.map((t) => {
  const id = `term-${slugify(t.term)}`;
  if (seedIds.has(id)) throw new Error(`glossary: ${id} clashes with a seed term`);
  return { ...t, id, read: t.read.map(([ref, label]) => ({ url: guideUrl(ref), label })) };
}).sort((a, b) => a.term.localeCompare(b.term));
const practice = own(PRACTICE_TERMS);
const case3 = own(CASE3_TERMS);
const total = terms.length + practice.length + case3.length;
---
<Base title="Glossary" description={`${total} terms: the ${terms.length} the seed paper defines, in its own words, plus the practice's terms and Case 3's, each linked to the page that teaches it.`} nav="glossary">
  <div class="wrap wrap--reading">
    <div class="page-head reading">
      <p class="eyebrow">{total} terms</p>
      <h1>Glossary</h1>
      <p class="lede">The practice’s working vocabulary, in three parts. First, the {terms.length} terms the seed paper defines in its lists, in its own words: {sources.join(', ').replace(/, ([^,]*)$/, ' and $1')}. Then the guide’s own practice terms, and the terms Case 3 uses.</p>
      <p class="muted">The three terms that carry the paper (driver, coefficient and rate) are introduced in <a href="/paper/1-introduction/">Section 1</a>. Where the guide has a page that teaches a term, “Read the concept” links to it.</p>
    </div>
    <nav aria-label="Glossary sections"><ul class="letters">
      {letters.map((l) => <li><a href={`#letter-${l}`}>{l}</a></li>)}
      <li class="letters__part"><a href="#practice-terms">Practice terms</a></li>
      <li class="letters__part"><a href="#case-3-terms">Case 3 terms</a></li>
    </ul></nav>
    <div class="gloss">
      <h2 class="gloss__part" id="seed-terms">The seed paper’s terms</h2>
      {letters.map((l) => (
        <section aria-labelledby={`letter-${l}`}>
          <h3 class="letter" id={`letter-${l}`}>{l}</h3>
          <dl>
            {terms.filter((t) => letterOf(t) === l).map((t) => (
              <div class="entry">
                <dt id={t.id}>{t.term}</dt>
                <dd>
                  {t.defs.map((d) => (
                    <Fragment>
                      <p class="def" set:html={renderInline(d.def, ctx.targets)} />
                      <p class="from">Defined in <a href={d.url}>{d.label}</a></p>
                    </Fragment>
                  ))}
                  {SEED_NOTES[t.id] && <p class="gloss__note"><span class="gloss__tag">Practice note</span> {SEED_NOTES[t.id]}</p>}
                  {SEED_CONCEPTS[t.id] && <p class="read">Read the concept: <a href={guideUrl(SEED_CONCEPTS[t.id][0])}>{SEED_CONCEPTS[t.id][1]}</a></p>}
                  {t.usedIn.length > 0 && (
                    <p class="used">Used in: {t.usedIn.map((u, i) => <Fragment>{i > 0 && ', '}<a href={u.url}>{pageLabel(u.page)}</a></Fragment>)}</p>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      <section aria-labelledby="practice-terms" class="gloss__group">
        <h2 class="gloss__part" id="practice-terms">Practice terms</h2>
        <p class="muted">Terms the guide uses that the seed’s lists don’t define. Each is a short paraphrase of the guide page linked, which carries the sources.</p>
        <dl>
          {practice.map((t) => (
            <div class="entry">
              <dt id={t.id}>{t.term}</dt>
              <dd>
                <p class="def" set:html={renderInline(t.def, ctx.targets)} />
                {t.seed && <p class="from" set:html={`Seed paper: ${renderInline(t.seed, ctx.targets)}`} />}
                <p class="read">Read the concept: {t.read.map((r, i) => <Fragment>{i > 0 && ', '}<a href={r.url}>{r.label}</a></Fragment>)}</p>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="case-3-terms" class="gloss__group">
        <h2 class="gloss__part" id="case-3-terms">Case 3 terms</h2>
        <p class="muted">The working vocabulary of <a href="/cases/kuantillion-cloud/">Case 3, Kuantillion Cloud</a>: reusing older SSDs during a flash shortage. Kuantillion Cloud is fictional. These meanings are the case’s, not the seed paper’s.</p>
        <dl>
          {case3.map((t) => (
            <div class="entry">
              <dt id={t.id}>{t.term} <span class="gloss__tag">Case 3</span></dt>
              <dd>
                <p class="def" set:html={renderInline(t.def, ctx.targets)} />
                {t.seed && <p class="from" set:html={`Seed paper: ${renderInline(t.seed, ctx.targets)}`} />}
                <p class="read">Read more: {t.read.map((r, i) => <Fragment>{i > 0 && ', '}<a href={r.url}>{r.label}</a></Fragment>)}</p>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</Base>
