---
// /agenda/: the open problems the room works on, each with a thread and a
// status. Items live in site/src/data/agenda.mjs.
import Base from '../layouts/Base.astro';
---
<Base title="Agenda" description="The open problems the Practice Room works on, each with a source, a thread and a status." nav="room">
  <div class="wrap wrap--reading">
    <div class="page-head reading">
      <p class="eyebrow">The Practice Room</p>
      <h1>Open problems</h1>
      <p class="lede">Pick one. Reply in its thread, or ask in the room.</p>
    </div>
    <p class="reading">The author’s notes on the seed paper are the first open problems. They are listed on <a href="/open-questions/">Open questions</a>.</p>
  </div>
</Base>
