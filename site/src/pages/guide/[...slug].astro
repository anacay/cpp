---
import Base from '../../layouts/Base.astro';
import HelpBuild from '../../components/HelpBuild.astro';
import WhereStrip from '../../components/WhereStrip.astro';
import { guide, renderGuide, seedLinks, neighboursOf, KINDS } from '../../lib/guide.mjs';
import { load, renderInline } from '../../lib/paper.mjs';

export function getStaticPaths() {
  return guide().pages.map((p) => ({ params: { slug: p.url.replace(/^\/guide\/|\/$/g, '') }, props: { file: p.file } }));
}
const g = guide();
const page = g.byFile.get(Astro.props.file);
const { html, toc } = renderGuide(page);
const seeds = seedLinks(page);
const { prev, next } = neighboursOf(page);
const c = load().config.community;
const ctx = load();
---
<Base title={page.title} description={page.short} nav="bok" commentable={{ name: `Guide: ${page.title}` }}>
  <div class="wrap wrap--reading">
    <div class="page-head">
      <p class="crumbs"><a href="/body-of-knowledge/">Body of knowledge</a> <span aria-hidden="true">›</span> <a href={`/body-of-knowledge/#${page.kind}`}>{KINDS[page.kind].label}</a></p>
      <p class="draft-tag">Guide · draft for review</p>
      <h1>{page.title}</h1>
      <p class="in-short guide-short"><em set:html={renderInline(page.short, ctx.targets)} /></p>
    </div>
    <WhereStrip page={page} />
    {toc.length > 2 && (
      <nav class="toc" aria-labelledby="toc-h"><h2 id="toc-h">On this page</h2><ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol></nav>
    )}
    <article class="prose reading-wrap guide-body" set:html={html} />
    {seeds.length > 0 && (
      <p class="seed-from">Drawn from the seed paper: {seeds.map((s, i) => <>{i > 0 && ', '}{s.url ? <a href={s.url}>{s.label}</a> : s.label}</>)}.</p>
    )}
    <HelpBuild file={`body-of-knowledge/guide/${page.file}`} name={`Guide: ${page.title}`} what="This page is a draft of the guide to the body of knowledge." />
    <nav class="pager" aria-label="Reading order">
      {prev && <a class="prev" href={prev.url} rel="prev"><span class="dir">Previous</span><span class="t">{prev.title}</span></a>}
      {next && <a class="next" href={next.url} rel="next"><span class="dir">Next</span><span class="t">{next.title}</span></a>}
    </nav>
  </div>
</Base>
